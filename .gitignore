# secrets -- listed first so it is never accidentally reordered below a negation
.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.DS_Store
.ipynb_checkpoints/

# datasets and model weights are never committed
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
*.pt
*.pth
*.onnx

# local tooling
.claude/

# Byproduct of running uv in a repo that installs with pip.
uv.lock
